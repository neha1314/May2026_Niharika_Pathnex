# Day 05 — Handlers, User-Data, Resource Limits

## 🔹 Ansible — Handler to Restart Nginx

---

-name: Handler to restart Nginx
 hosts: all
 become: yes

tasks:
  -name: update config
   copy:
        src: index.html
        dest: /usr/share/nginx/html/index.html
      notify: Restart Nginx

   handlers:
     - name: Restart Nginx
      service:
        name: nginx
        state: restarted


## 🔹 Terraform — EC2 with User Data (c6a.12xlarge)

resources "aws_instance" "ec2-user-data"{
  ami= "ami_nsknfknksnf"
  instace_type= "c6a.12xlarge"

  user_data= <<EOF
 #!/bin/bash
  yum install httpd
  systemctl start httpd
  EOF

