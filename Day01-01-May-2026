#Day1

#Ansible Task- Installing nginx on pathnex server

- name: Install nginx on pathnex  server
  hosts: all #The play runs on all hosts listed in your Ansible inventory.
  become: yes #Tells Ansible to use privilege escalation (typically sudo) because installing software requires root access.

  tasks:
    -name: Install nginx
     yum:
       name: nginx
       state: present #Ensures nginx is installed.

#Terraform Task - Create EC2(c5.xlarge)

provider "aws"{
  region="us-east-1"
}

resource "aws_instance" "EC2"{
   ami           = "ami-0abcd1234abcd1234"
  instance_type = "c5.xlarge"

 tag{
  Name="ec2"
  }
}

#Kubernetes task- Create Nginx pods

apiVersion: v1  #Specifies the Kubernetes API version.v1 is used for core resources like Pods and Services
kind:Pod
metadata:
  name: pod1
spec:  #Defines the desired state of the Pod.spec = Specification (desired state)
 containers:
   -name: nginx-container
    image: nginx:latest
    ports:
      -containerport: 80

