#Ansible task- Install and enable nginx

-name: Install & enabled nginx
 hosts: all
 become: yes

tasks:
    -name: Install nginx
     image: nginx:latest
     state: present

    -name: Enable nginx
     service:
     name: nginx
     state: started
     enabled: yes


#Terraform - Create Ec2 instance (r5.2xlarge) 

provider "aws" {
 region= "us-east-1"
}

resource "aws_instance" "EC2"{
     ami=  "ami-0abcd1234abcd1234"
     instance_type= "r5.2xlarge"
    tags={
      Name = "Pathnex-Server"
      Environment = "Training"
      Owner = "PathnexStudent"
  }
}


#Kubernetes- Deployment with 2 replicas

apiVersion: apps/v1
kind: Deployment #A Deployment manages Pods and ensures the desired number of replicas are running, handling updates and restarts.
metadata:
  name: pathnex-deployment
spec:
  replicas: 2
  selector: #Tells the Deployment which Pods it manages.
    matchLabels: #The Deployment manages Pods that have the label
      app: pathnex-app
  template: #Pod template
     #This section defines how each Pod should be created.
    metadata:
      labels:
        app: pathnex-app
    spec:
      containers:
        - name: app
          image: nginx
          ports:
            - containerPort: 80


